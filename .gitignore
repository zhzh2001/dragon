build/
.cache/
compile_commands.json
.DS_Store
*.dSYM/

# Written at runtime. A record is personal, and committing the autopilot's time
# as though it were the player's would be wrong.
assets/best_times.txt
assets/runs.txt

# Model assets are large (65 MB each with textures), re-downloadable, and
# NonCommercial-licensed. Kept out of the repo rather than redistributed; see
# ATTRIBUTION.md for where to get them.
assets/*.glb
assets/*.gltf
# Model packs are build products (anim/model_pack.h): `dragon --bake-packs`
# remakes every one in seconds, and the packagers bake their own.
*.pack
assets/alt/
assets/black_dragon_with_idle_animation/
# Embercrest (the original-model experiment): the GLB, .blend, textures and
# revisions are all regenerated by tools/build_embercrest.py, so only the
# generator, the docs and a few renders are tracked. assets/*.glb above already
# covers assets/embercrest-scripted.glb.
assets/embercrest-scripted/
# The editable .blend the rigger saves beside each generated creature, one
# directory per stem. 45-80 MB each because the source textures are packed
# into them, and every one is reproduced by re-running
# tools/rig_embercrest_candidate.py with that creature's skeleton JSON. The
# skeleton, the build_stats.json and the pose renders are the tracked record.
assets/stormsail/
assets/ashcoil/
assets/cragjaw/
assets/mossback/
assets/rimefang/
assets/blightmaw/
assets/ironroot/
assets/tidewrack/
assets/frostvein/
assets/sunspear/
assets/rimeplume/
assets/gold-dragon/
assets/silver-dragon-reference/
assets/silver-dragon/
artifacts/gold-dragon-rig/measurement/canonical-points.npy
artifacts/gold-dragon-rig/materials/*.glb
artifacts/sunspear/materials/*.glb
artifacts/rimeplume/materials/*.glb
tools/__pycache__/
artifacts/**/*.bmp
artifacts/**/*.log
.DS_Store

# Generated PBR maps that come with a generated mesh (4K each, ~34 MB a set).
# Same reasoning as assets/*.glb above: large, regenerable from the service,
# and under hosted terms we never fetched.
assets/embercrest-textures/

# Engine capture dirs written by the rig-validation tools. The BMPs and logs
# are already ignored above; their PNG conversions are the same frames again,
# and both are regenerated by re-running the capture. The pose renders and the
# validation/build JSON beside them are kept -- those are the acceptance record.
artifacts/**/runtime/
assets/*.bak

# Release packaging (tools/release/package_macos.sh).
build-release/
build-win/
build-r0/
# Holds a copy of Microsoft's d3dcompiler_47.dll for the D3D9 bake; never committed.
build-d3d9/
build-win-release/
build-xp/
build-xp-release/
dist/

# Regenerated sidecars for the local silver raw/material comparison.
assets/silver-dragon-raw.glb.*.cfg
__pycache__/
build-mobile-bench/
build-android/
build-gles/
build-pi/
build-rockkit-cache/
build-hero-cache/
build-hero-rig-cache/

# Raw Tripo Studio exports (tools/tripo_studio.py): 70 MB each, kept on this
# machine. The processed pieces are what the game loads.
assets/tripo-raw/
build-landmarks-cache/
# Trial copies of the hero with Tripo's hide (tools/hide/tripo_hide_trial.py).
assets/embercrest-hero-tripo*.cfg

build-prey-cache/

# Single engine frames the clip and rig jobs capture on the way to a
# contact sheet (tools/clips/README.md). The sheets are committed.
artifacts/hero-flight/before/
artifacts/hero-flight/after/
artifacts/hero-body/before/
artifacts/hero-body/after/
artifacts/wingbeat/*/before/
artifacts/wingbeat/*/after/
artifacts/silver-dragon-integration/pass3/before/
artifacts/silver-dragon-integration/pass3/after/
artifacts/gold-dragon-integration/pass3/before/
artifacts/gold-dragon-integration/pass3/after/

# Scratch directories of the asset jobs: single frames, intermediate models.
build-clip-cache/
build-rig-cache/
