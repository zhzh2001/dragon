*.dSYM/

# Written at runtime. A record is personal, and committing the autopilot's time
# as though it were the player's would be wrong.
assets/best_times.txt

# Model assets are large (65 MB each with textures), re-downloadable, and
# NonCommercial-licensed. Kept out of the repo rather than redistributed; see
# ATTRIBUTION.md for where to get them.
assets/*.glb
assets/*.gltf
assets/alt/
assets/black_dragon_with_idle_animation/
# Embercrest (the original-model experiment): the GLB, .blend, textures and
# revisions are all regenerated by tools/build_embercrest.py, so only the
# generator, the docs and a few renders are tracked. assets/*.glb above already
# covers assets/embercrest.glb.
assets/embercrest/
tools/__pycache__/
artifacts/**/*.bmp
artifacts/**/*.log
.DS_Store
