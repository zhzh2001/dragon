build/
.cache/
compile_commands.json
.DS_Store
*.dSYM/

# Written at runtime. A record is personal, and committing the autopilot's time
# as though it were the player's would be wrong.
assets/best_times.txt
assets/runs.txt

# Model assets are large (65 MB each with textures), re-downloadable, and
# NonCommercial-licensed. Kept out of the repo rather than redistributed; see
# ATTRIBUTION.md for where to get them.
assets/*.glb
assets/*.gltf
assets/alt/
assets/black_dragon_with_idle_animation/
# Embercrest (the original-model experiment): the GLB, .blend, textures and
# revisions are all regenerated by tools/build_embercrest.py, so only the
# generator, the docs and a few renders are tracked. assets/*.glb above already
# covers assets/embercrest-scripted.glb.
assets/embercrest-scripted/
# The editable .blend the rigger saves beside each generated creature, one
# directory per stem. 45-80 MB each because the source textures are packed
# into them, and every one is reproduced by re-running
# tools/rig_embercrest_candidate.py with that creature's skeleton JSON. The
# skeleton, the build_stats.json and the pose renders are the tracked record.
assets/stormsail/
assets/ashcoil/
assets/cragjaw/
assets/mossback/
assets/rimefang/
assets/blightmaw/
assets/ironroot/
assets/tidewrack/
assets/frostvein/
assets/sunspear/
assets/rimeplume/
tools/__pycache__/
artifacts/**/*.bmp
artifacts/**/*.log
.DS_Store

# Generated PBR maps that come with a generated mesh (4K each, ~34 MB a set).
# Same reasoning as assets/*.glb above: large, regenerable from the service,
# and under hosted terms we never fetched.
assets/embercrest-textures/

# Engine capture dirs written by the rig-validation tools. The BMPs and logs
# are already ignored above; their PNG conversions are the same frames again,
# and both are regenerated by re-running the capture. The pose renders and the
# validation/build JSON beside them are kept -- those are the acceptance record.
artifacts/**/runtime/
assets/*.bak

# Release packaging (tools/release/package_macos.sh).
build-release/
build-win/
build-win-release/
dist/
