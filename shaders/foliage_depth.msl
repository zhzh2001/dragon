#include "scene_common.msl"

// Depth-only instanced plants for the shadow map. The same placement and sway
// as foliage.msl, so a swaying crown casts a swaying shadow.

struct FoliageParams {
    float4 wind_time_fade;
    float4 extra;
};

struct ShadowUniforms {
    float4x4 light_view_proj;
};

struct VertexIn {
    float3 position       [[attribute(0)]];
    float3 normal         [[attribute(1)]];
    float3 color          [[attribute(2)]];
    float2 uv             [[attribute(3)]];
    float4 position_scale [[attribute(4)]];
    float4 params         [[attribute(5)]];
};

struct DepthOut {
    float4 clip_position [[position]];
    float2 uv;
    float material;
};

vertex DepthOut vs_main(VertexIn in [[stage_in]],
                        constant ShadowUniforms& shadow [[buffer(0)]],
                        constant FoliageParams& params [[buffer(1)]]) {
    float yaw = in.params.x;
    float c = cos(yaw), s = sin(yaw);
    float3 local = in.position * in.position_scale.w;
    float3 rotated = float3(c * local.x + s * local.z, local.y, -s * local.x + c * local.z);
    float height_fraction = saturate(local.y / max(in.position_scale.w * params.extra.x, 0.01));
    float t = params.wind_time_fade.y;
    float sway = params.wind_time_fade.x * height_fraction * height_fraction *
                 (sin(t * 1.3 + in.params.z) + 0.5 * sin(t * 2.9 + in.params.z * 1.7));
    rotated.x += sway;
    rotated.z += sway * 0.6;
    DepthOut out;
    out.clip_position = shadow.light_view_proj * float4(in.position_scale.xyz + rotated, 1.0);
    out.uv = in.uv;
    int tag = int(in.color.z + 0.5);
    out.material = float(tag >= 10 ? tag - 10 : tag);
    return out;
}

// A card's shadow is the shape cut out of it, not the quad: the same alpha
// test as the colour pass, against the same textures (1 leaf, 2 needle).
fragment void fs_main(DepthOut in [[stage_in]],
                      texture2d<float> leaf_card [[texture(0)]],
                      sampler leaf_sampler [[sampler(0)]],
                      texture2d<float> needle_card [[texture(1)]],
                      sampler needle_sampler [[sampler(1)]]) {
    int material = int(in.material + 0.5);
    if (material == 1 || material == 2) {
        float alpha = material == 1 ? leaf_card.sample(leaf_sampler, in.uv).a
                                    : needle_card.sample(needle_sampler, in.uv).a;
        if (alpha < 0.45) discard_fragment();
    }
}
