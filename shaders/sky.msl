#include "scene_common.msl"

// Fullscreen sky. Drawn first with no depth test, so the terrain overwrites it.
// Three vertices generated from vertex_id -- no vertex buffer needed.

struct VertexOut {
    float4 clip_position [[position]];
    float2 ndc;
};

vertex VertexOut vs_main(uint vertex_id [[vertex_id]]) {
    // A triangle large enough to cover the whole clip volume.
    float2 positions[3] = {float2(-1.0, -1.0), float2(3.0, -1.0), float2(-1.0, 3.0)};
    VertexOut out;
    out.ndc = positions[vertex_id];
    // z = 0 is the far plane under reversed-Z, which is where sky belongs.
    out.clip_position = float4(positions[vertex_id], 0.0, 1.0);
    return out;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]]) {
    // Rebuild the view ray from the camera basis rather than inverting the
    // view-projection matrix.
    float tan_half_fov = scene.view_params.x;
    float aspect = scene.view_params.y;
    float3 ray = normalize(scene.camera_forward.xyz +
                           scene.camera_right.xyz * in.ndc.x * tan_half_fov * aspect +
                           scene.camera_up.xyz * in.ndc.y * tan_half_fov);
    return float4(sky_color(ray, scene), 1.0);
}
