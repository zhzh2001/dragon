#include "model_common.msl"

// Lit opaque geometry with per-vertex albedo. Used for the dragon and for any
// greybox prop, so it deliberately has no texture support yet.

struct VertexIn {
    float3 position [[attribute(0)]];
    float3 normal   [[attribute(1)]];
    float3 color    [[attribute(2)]];
};

struct VertexOut {
    float4 clip_position [[position]];
    float3 world_position;
    float3 world_normal;
    float3 albedo;
    float emissive;
    // Carried as a varying rather than read from ModelUniforms: the fragment
    // stage does not bind the model block, and one interpolant is cheaper than
    // adding a binding to every pipeline that uses this shader.
    float unlit;
};

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant SceneUniforms& scene [[buffer(0)]],
                         constant ModelUniforms& model [[buffer(1)]]) {
    VertexOut out_vertex;
    float4 world = model.model * float4(in.position, 1.0);
    out_vertex.world_position = world.xyz;
    // Uniform scale only, so the upper 3x3 rotates normals correctly without an
    // inverse transpose.
    out_vertex.world_normal = normalize((model.model * float4(in.normal, 0.0)).xyz);
    out_vertex.albedo = in.color * model.tint.rgb;
    out_vertex.emissive = model.tint.a;
    out_vertex.unlit = model.material.w;
    out_vertex.clip_position = scene.view_proj * world;
    return out_vertex;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]],
                        depth2d<float> shadow_map [[texture(0)]],
                        sampler shadow_sampler [[sampler(0)]]) {
    float3 normal = normalize(in.world_normal);

    // Wings are thin plates seen from both sides, so light the face that is
    // actually turned toward the viewer.
    float3 to_camera = normalize(scene.camera_position.xyz - in.world_position);
    if (dot(normal, to_camera) < 0.0) normal = -normal;

    float visibility = sun_visibility(in.world_position, normal, scene, shadow_map,
                                      shadow_sampler);
    float3 direct = direct_sun(normal, visibility, scene);
    float3 ambient = ambient_light(normal, scene);

    // Emissive is added after lighting and before fog, so a glowing checkpoint
    // still fades into the distance rather than punching through the haze.
    //
    // material.w marks the object as unlit: its colour is purely emissive, with
    // no sun or ambient term at all. Fire needs this. The shared tonemap ends in
    // a gamma encode, so a bright surface desaturates toward white -- adding two
    // units of sunlight on top of a flame turns it into a white balloon.
    float3 lit = in.albedo * in.emissive;
    if (in.unlit < 0.5) lit += in.albedo * (direct + ambient);

    return float4(tonemap(apply_fog(lit, in.world_position, scene)), 1.0);
}
