#include "model_common.msl"

// Lit opaque geometry with per-vertex albedo. Used for the dragon and for any
// greybox prop, so it deliberately has no texture support yet.

struct VertexIn {
    float3 position [[attribute(0)]];
    float3 normal   [[attribute(1)]];
    float3 color    [[attribute(2)]];
};

struct VertexOut {
    float4 clip_position [[position]];
    float3 world_position;
    float3 world_normal;
    float3 albedo;
    float emissive;
};

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant SceneUniforms& scene [[buffer(0)]],
                         constant ModelUniforms& model [[buffer(1)]]) {
    float3 local = deform_vertex(in.position, model);

    // The deformation makes the mesh's authored normals wrong. Recovering them
    // properly means differentiating the deformation; for a greybox placeholder,
    // rotating the normal by the same wing angle is close enough and costs
    // nothing. The real rig will compute these from the skeleton.
    float3 local_normal = in.normal;
    const float out = abs(in.position.x) - model.wing.z;
    if (out > 0.0) {
        const float t = saturate(out / max(model.wing.w - model.wing.z, 0.001));
        const float angle = model.wing.x * t;
        const float c = cos(angle), s = sin(angle);
        local_normal = float3(local_normal.x * c - local_normal.y * s,
                              local_normal.x * s + local_normal.y * c, local_normal.z);
    }

    VertexOut out_vertex;
    float4 world = model.model * float4(local, 1.0);
    out_vertex.world_position = world.xyz;
    // Uniform scale only, so the upper 3x3 rotates normals correctly without an
    // inverse transpose.
    out_vertex.world_normal = normalize((model.model * float4(local_normal, 0.0)).xyz);
    out_vertex.albedo = in.color * model.tint.rgb;
    out_vertex.emissive = model.tint.a;
    out_vertex.clip_position = scene.view_proj * world;
    return out_vertex;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]],
                        depth2d<float> shadow_map [[texture(0)]],
                        sampler shadow_sampler [[sampler(0)]]) {
    float3 normal = normalize(in.world_normal);
    float3 to_sun = normalize(scene.sun.xyz);

    // Wings are thin plates seen from both sides, so light the face that is
    // actually turned toward the viewer.
    float3 to_camera = normalize(scene.camera_position.xyz - in.world_position);
    if (dot(normal, to_camera) < 0.0) normal = -normal;

    float wrapped = saturate((dot(normal, to_sun) + 0.2) / 1.2);
    float visibility = sun_visibility(in.world_position, normal, scene, shadow_map,
                                      shadow_sampler);
    float3 direct = scene.sun_color.rgb * scene.sun.w * wrapped * visibility;

    float sky_amount = saturate(normal.y * 0.5 + 0.5);
    float3 ambient =
        mix(scene.fog_color.rgb, scene.sky_zenith.rgb, sky_amount) * scene.terrain_params.w;

    // Emissive is added after lighting and before fog, so a glowing checkpoint
    // still fades into the distance rather than punching through the haze.
    float3 lit = in.albedo * (direct + ambient) + in.albedo * in.emissive;

    float distance = length(in.world_position - scene.camera_position.xyz);
    float density = scene.fog_color.a * exp(-max(in.world_position.y, 0.0) * 0.0018);
    float fog = 1.0 - exp(-pow(distance * density, 2.0));
    float3 ray = normalize(in.world_position - scene.camera_position.xyz);
    float3 fogged = mix(lit, sky_color(ray, scene), saturate(fog));

    return float4(tonemap(fogged), 1.0);
}
