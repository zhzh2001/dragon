#include "scene_common.msl"

// Additive billboard particles. Quads arrive already camera-facing from the
// CPU; the fragment shader just shapes each into a soft disc. Blending is
// ONE + ONE, so colour is emitted light and darkness is simply not drawing.

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color    [[attribute(1)]];
    float2 corner   [[attribute(2)]];
};

struct VertexOut {
    float4 clip_position [[position]];
    float4 color;
    float2 corner;
};

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant float4x4& view_proj [[buffer(0)]]) {
    VertexOut out;
    out.clip_position = view_proj * float4(in.position, 1.0);
    out.color = in.color;
    out.corner = in.corner;
    return out;
}

fragment float4 fs_main(VertexOut in [[stage_in]]) {
    // Soft disc with a hot centre: quadratic falloff squared reads as a glow
    // core rather than a flat coin.
    float r = length(in.corner);
    float falloff = saturate(1.0 - r);
    falloff *= falloff;
    return float4(in.color.rgb * falloff, 1.0);
}
