// Per-object transform plus the procedural wing deformation.
//
// The deformation lives in the vertex shader rather than in a skeleton, which is
// how the real dragon will work too: wing flap driven by a phase oscillator,
// not by animation clips. This is that approach in miniature.
#pragma once

#include "scene_common.msl"

// Must match gfx::ModelUniforms exactly -- a mismatch is a shader compile error
// at startup, which the pipeline cache reports rather than crashing on.
struct ModelUniforms {
    float4x4 model;
    // rgb multiplies vertex colour, a is an unlit emissive add.
    float4 tint;
    // x: 1 when a base-colour texture is bound, 0 to use the vertex colour.
    float4 material;
    // rgb: hue to push the albedo toward at its own luminance; a: how far.
    float4 recolour;
};
