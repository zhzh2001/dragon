#include "post_common.msl"

// Bloom, steps two and three: a 9-tap Gaussian along post.texel.zw (one axis
// per pass). Half resolution, so the whole blur is a few hundred microseconds.
fragment float4 fs_main(PostVertex in [[stage_in]],
                        constant PostUniforms& post [[buffer(0)]],
                        texture2d<float> source [[texture(0)]],
                        sampler linear [[sampler(0)]]) {
    const float weights[5] = {0.2270270270, 0.1945945946, 0.1216216216, 0.0540540541, 0.0162162162};
    float2 step = post.texel.xy * post.texel.zw;
    float3 c = source.sample(linear, in.uv).rgb * weights[0];
    for (int i = 1; i < 5; ++i) {
        float2 offset = step * float(i) * 1.5;
        c += source.sample(linear, in.uv + offset).rgb * weights[i];
        c += source.sample(linear, in.uv - offset).rgb * weights[i];
    }
    return float4(c, 1.0);
}
