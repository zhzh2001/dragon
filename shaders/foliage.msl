#include "scene_common.msl"

// Instanced plants: one mesh, thousands of placements. The instance carries
// where the plant stands, how big it is, which way it faces, its shade and a
// sway phase; the mesh carries the shape and the material in vertex colour.

struct FoliageParams {
    float4 wind_time_fade;  // x wind, y time, z fade start, w fade end
    float4 extra;           // x nominal height at scale 1
};

struct VertexIn {
    float3 position       [[attribute(0)]];
    float3 normal         [[attribute(1)]];
    float3 color          [[attribute(2)]];
    float2 uv             [[attribute(3)]];
    float4 position_scale [[attribute(4)]];
    float4 params         [[attribute(5)]];
};

// The vertex colour's third channel names the material (gfx/palette.h,
// FoliageMaterial): plain, a leaf card, a needle card, bark; plus 10 for a
// detail card the LOD may drop.
constexpr constant int FOLIAGE_MAT_PLAIN = 0;
constexpr constant int FOLIAGE_MAT_LEAF = 1;
constexpr constant int FOLIAGE_MAT_NEEDLE = 2;
constexpr constant int FOLIAGE_MAT_BARK = 3;
constexpr constant int FOLIAGE_DETAIL = 10;

struct VertexOut {
    float4 clip_position [[position]];
    float3 world_position;
    float3 world_normal;
    float3 albedo;
    float2 uv;
    // x material, y 1 when this is a detail card, z camera distance to the
    // plant's base (for the LOD), w instance hash (for the LOD dither)
    float4 material;
};

// Shared with the depth pass: the placed, swaying vertex in world space.
static inline float3 place_vertex(VertexIn in, constant FoliageParams& params,
                                  float3 camera_position, thread float3& world_normal) {
    float yaw = in.params.x;
    float c = cos(yaw), s = sin(yaw);
    float3 local = in.position * in.position_scale.w;
    float3 rotated = float3(c * local.x + s * local.z, local.y, -s * local.x + c * local.z);

    // Distance fade for grass: the whole tuft shrinks into the ground rather
    // than blinking out. Trees pass fade distances far beyond the world.
    float distance = length(in.position_scale.xyz - camera_position);
    float fade = 1.0 - smoothstep(params.wind_time_fade.z, params.wind_time_fade.w, distance);
    rotated *= fade;

    // Sway grows with the square of the height fraction, so roots stay put
    // and crowns move. Two incommensurate frequencies, per-instance phase.
    float height_fraction = saturate(local.y / max(in.position_scale.w * params.extra.x, 0.01));
    float t = params.wind_time_fade.y;
    float sway = params.wind_time_fade.x * height_fraction * height_fraction *
                 (sin(t * 1.3 + in.params.z) + 0.5 * sin(t * 2.9 + in.params.z * 1.7));
    rotated.x += sway;
    rotated.z += sway * 0.6;

    world_normal = float3(c * in.normal.x + s * in.normal.z, in.normal.y,
                          -s * in.normal.x + c * in.normal.z);
    return in.position_scale.xyz + rotated;
}

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant SceneUniforms& scene [[buffer(0)]],
                         constant FoliageParams& params [[buffer(1)]]) {
    VertexOut out;
    float3 normal;
    float3 world = place_vertex(in, params, scene.camera_position.xyz, normal);
    out.world_position = world;
    out.world_normal = normalize(normal);
    // The mesh carries (palette entry, brightness) rather than a colour, so
    // the plant takes its green from the shared table. Per-instance shade
    // darkens or lightens the whole plant; the warm push (params.w) shifts a
    // crown toward yellow, which is what makes a forest read as many trees
    // rather than one green stamped a thousand times.
    int entry = clamp(int(in.color.x + 0.5), 0, PALETTE_COUNT - 1);
    float3 base = scene.palette[entry].rgb * in.color.y * in.params.y;
    out.albedo = mix(base, base * scene.palette[PALETTE_PLANT_WARM].rgb, in.params.w);
    out.uv = in.uv;
    int tag = int(in.color.z + 0.5);
    int material = tag >= FOLIAGE_DETAIL ? tag - FOLIAGE_DETAIL : tag;
    out.material = float4(float(material), tag >= FOLIAGE_DETAIL ? 1.0 : 0.0,
                          length(in.position_scale.xyz - scene.camera_position.xyz),
                          fract(in.params.z * 0.15915494));  // the sway phase, reused as a hash
    out.clip_position = scene.view_proj * float4(world, 1.0);
    return out;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]],
                        constant FoliageParams& params [[buffer(1)]],
                        depth2d<float> shadow_map [[texture(0)]],
                        sampler shadow_sampler [[sampler(0)]],
                        texture2d<float> leaf_card [[texture(1)]],
                        sampler leaf_sampler [[sampler(1)]],
                        texture2d<float> needle_card [[texture(2)]],
                        sampler needle_sampler [[sampler(2)]]) {
    int material = int(in.material.x + 0.5);

    // The distance LOD: past `lod_distance` the detail cards go and the coarse
    // ones carry the crown. Dithered per instance over a 30% band with the
    // instance's own hash, so a forest thins tree by tree instead of popping
    // at a line.
    if (in.material.y > 0.5) {
        float lod = params.extra.y;
        float t = (in.material.z - lod) / max(lod * 0.3, 1.0);
        if (t > in.material.w) discard_fragment();
    }

    float3 albedo = in.albedo;
    float3 geometric_normal = normalize(in.world_normal);
    if (material == FOLIAGE_MAT_LEAF || material == FOLIAGE_MAT_NEEDLE) {
        // The card: a grey detail map with the leaves cut out in alpha,
        // coloured by the palette. Alpha-tested, not blended: sorted-blend
        // foliage is a rabbit hole and the 2005 look shipped on the test.
        float4 card = material == FOLIAGE_MAT_LEAF
                          ? leaf_card.sample(leaf_sampler, in.uv)
                          : needle_card.sample(needle_sampler, in.uv);
        if (card.a < 0.45) discard_fragment();
        // The map's greys average about 0.45; normalised so the palette entry
        // is the crown's mean colour, with the map's mottle around it.
        albedo *= card.r * 2.2;
        // Dark undersides: the face turned toward the ground is in its own
        // shade. Judged on the geometric normal before the facing flip.
        float under = saturate(-geometric_normal.y);
        albedo *= 1.0 - 0.35 * under;
    } else if (material == FOLIAGE_MAT_BARK) {
        // Bark: vertical streaks, in u around the trunk and stretched along
        // v, from the same value noise the ground grains with.
        float streak = value_noise(float2(in.uv.x * 14.0, in.uv.y * 1.5));
        float fine = value_noise(float2(in.uv.x * 40.0, in.uv.y * 6.0));
        albedo *= 0.7 + 0.5 * streak + 0.15 * (fine - 0.5);
    }

    float3 normal = geometric_normal;
    float3 to_camera = normalize(scene.camera_position.xyz - in.world_position);
    if (dot(normal, to_camera) < 0.0) normal = -normal;

    // The shared lighting path, plus the one thing a crown has that rock does
    // not: sun leaking through it from behind.
    float visibility = sun_visibility(in.world_position, normal, scene, shadow_map,
                                      shadow_sampler);
    float translucency = material == FOLIAGE_MAT_BARK ? 0.0 : scene.light_params.y;
    float3 light = direct_sun(normal, visibility, scene) + ambient_light(normal, scene) +
                   translucent_sun(normal, visibility, translucency, scene);
    float3 lit = albedo * light;
    return float4(scene_out(apply_fog(lit, in.world_position, scene)), 1.0);
}
