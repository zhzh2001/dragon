#include "scene_common.msl"

// Instanced plants: one mesh, thousands of placements. The instance carries
// where the plant stands, how big it is, which way it faces, its shade and a
// sway phase; the mesh carries the shape and the material in vertex colour.

struct FoliageParams {
    float4 wind_time_fade;  // x wind, y time, z fade start, w fade end
    float4 extra;           // x nominal height at scale 1
};

struct VertexIn {
    float3 position       [[attribute(0)]];
    float3 normal         [[attribute(1)]];
    float3 color          [[attribute(2)]];
    float4 position_scale [[attribute(3)]];
    float4 params         [[attribute(4)]];
};

struct VertexOut {
    float4 clip_position [[position]];
    float3 world_position;
    float3 world_normal;
    float3 albedo;
};

// Shared with the depth pass: the placed, swaying vertex in world space.
static inline float3 place_vertex(VertexIn in, constant FoliageParams& params,
                                  float3 camera_position, thread float3& world_normal) {
    float yaw = in.params.x;
    float c = cos(yaw), s = sin(yaw);
    float3 local = in.position * in.position_scale.w;
    float3 rotated = float3(c * local.x + s * local.z, local.y, -s * local.x + c * local.z);

    // Distance fade for grass: the whole tuft shrinks into the ground rather
    // than blinking out. Trees pass fade distances far beyond the world.
    float distance = length(in.position_scale.xyz - camera_position);
    float fade = 1.0 - smoothstep(params.wind_time_fade.z, params.wind_time_fade.w, distance);
    rotated *= fade;

    // Sway grows with the square of the height fraction, so roots stay put
    // and crowns move. Two incommensurate frequencies, per-instance phase.
    float height_fraction = saturate(local.y / max(in.position_scale.w * params.extra.x, 0.01));
    float t = params.wind_time_fade.y;
    float sway = params.wind_time_fade.x * height_fraction * height_fraction *
                 (sin(t * 1.3 + in.params.z) + 0.5 * sin(t * 2.9 + in.params.z * 1.7));
    rotated.x += sway;
    rotated.z += sway * 0.6;

    world_normal = float3(c * in.normal.x + s * in.normal.z, in.normal.y,
                          -s * in.normal.x + c * in.normal.z);
    return in.position_scale.xyz + rotated;
}

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant SceneUniforms& scene [[buffer(0)]],
                         constant FoliageParams& params [[buffer(1)]]) {
    VertexOut out;
    float3 normal;
    float3 world = place_vertex(in, params, scene.camera_position.xyz, normal);
    out.world_position = world;
    out.world_normal = normalize(normal);
    out.albedo = in.color * in.params.y;
    out.clip_position = scene.view_proj * float4(world, 1.0);
    return out;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]],
                        depth2d<float> shadow_map [[texture(0)]],
                        sampler shadow_sampler [[sampler(0)]]) {
    float3 normal = normalize(in.world_normal);
    float3 to_sun = normalize(scene.sun.xyz);
    float3 to_camera = normalize(scene.camera_position.xyz - in.world_position);
    if (dot(normal, to_camera) < 0.0) normal = -normal;

    // Foliage is translucent in the mass: light leaks through a canopy, so the
    // wrap is wider than a solid surface gets.
    float wrapped = saturate((dot(normal, to_sun) + 0.35) / 1.35);
    float visibility = sun_visibility(in.world_position, normal, scene, shadow_map,
                                      shadow_sampler);
    float3 direct = scene.sun_color.rgb * scene.sun.w * wrapped * visibility;
    float sky_amount = saturate(normal.y * 0.5 + 0.5);
    float3 ambient =
        mix(scene.fog_color.rgb, scene.sky_zenith.rgb, sky_amount) * scene.terrain_params.w;
    float3 lit = in.albedo * (direct + ambient);

    float distance = length(in.world_position - scene.camera_position.xyz);
    float density = scene.fog_color.a * exp(-max(in.world_position.y, 0.0) * 0.0018);
    float fog = 1.0 - exp(-pow(distance * density, 2.0));
    float3 ray = normalize(in.world_position - scene.camera_position.xyz);
    float3 fogged = mix(lit, sky_color(ray, scene), saturate(fog));
    return float4(tonemap(fogged), 1.0);
}
