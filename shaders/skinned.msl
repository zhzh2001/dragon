#include "model_common.msl"

// Skinned character rendering.
//
// Joint matrices arrive as a uniform array rather than a storage buffer: 16 KB
// per draw, which avoids maintaining a per-frame buffer. Must match
// anim::MAX_JOINTS.
constexpr constant uint MAX_JOINTS = 256;

struct SkinUniforms {
    float4x4 joints[MAX_JOINTS];
};

struct VertexIn {
    float3 position    [[attribute(0)]];
    float3 normal      [[attribute(1)]];
    float3 color       [[attribute(2)]];
    float2 uv          [[attribute(3)]];
    uchar4 joint_index [[attribute(4)]];
    float4 weight      [[attribute(5)]];
    float4 tangent     [[attribute(6)]];
};

struct VertexOut {
    float4 clip_position [[position]];
    float3 world_position;
    float3 world_normal;
    float3 albedo;
    float2 uv;
    float emissive;
    float3 world_tangent;
    float tangent_sign;
};

vertex VertexOut vs_main(VertexIn in [[stage_in]],
                         constant SceneUniforms& scene [[buffer(0)]],
                         constant ModelUniforms& model [[buffer(1)]],
                         constant SkinUniforms& skin [[buffer(2)]]) {
    // Linear blend skinning. Weights are normalized on the CPU, so no rescaling
    // is needed here.
    float4x4 blended = skin.joints[in.joint_index.x] * in.weight.x;
    blended += skin.joints[in.joint_index.y] * in.weight.y;
    blended += skin.joints[in.joint_index.z] * in.weight.z;
    blended += skin.joints[in.joint_index.w] * in.weight.w;

    float4 skinned_position = blended * float4(in.position, 1.0);
    // Blending matrices this way is only correct for rotation and uniform scale,
    // which is all a rig uses. Rotating the normal by the same blend is the usual
    // approximation and is right up to non-uniform scale.
    float3 skinned_normal = (blended * float4(in.normal, 0.0)).xyz;
    float3 skinned_tangent = (blended * float4(in.tangent.xyz, 0.0)).xyz;

    float4 world = model.model * skinned_position;

    VertexOut out;
    out.world_position = world.xyz;
    out.world_normal = normalize((model.model * float4(skinned_normal, 0.0)).xyz);
    out.world_tangent = (model.model * float4(skinned_tangent, 0.0)).xyz;
    // Handedness survives skinning: it is a property of the UV layout, not of
    // the pose.
    out.tangent_sign = in.tangent.w;
    out.albedo = in.color * model.tint.rgb;
    out.uv = in.uv;
    out.emissive = model.tint.a;
    out.clip_position = scene.view_proj * world;
    return out;
}

fragment float4 fs_main(VertexOut in [[stage_in]],
                        constant SceneUniforms& scene [[buffer(0)]],
                        constant ModelUniforms& model [[buffer(1)]],
                        depth2d<float> shadow_map [[texture(0)]],
                        sampler shadow_sampler [[sampler(0)]],
                        texture2d<float> base_colour [[texture(1)]],
                        sampler base_sampler [[sampler(1)]],
                        texture2d<float> normal_map [[texture(2)]],
                        sampler normal_sampler [[sampler(2)]],
                        texture2d<float> orm_map [[texture(3)]],
                        sampler orm_sampler [[sampler(3)]]) {
    float3 normal = normalize(in.world_normal);
    float3 to_sun = normalize(scene.sun.xyz);
    float3 to_camera = normalize(scene.camera_position.xyz - in.world_position);

    // Wing membranes are thin and seen from both sides, so light whichever face
    // is actually turned toward the viewer. Done before the normal map so the
    // tangent frame is flipped consistently with the geometric normal.
    float side = dot(normal, to_camera) < 0.0 ? -1.0 : 1.0;
    normal *= side;

    // A degenerate tangent would normalize to NaN, so it is rejected before any
    // of the frame is built from it.
    if (model.material.y > 0.5 && length_squared(in.world_tangent) > 1e-8) {
        // Gram-Schmidt: skinning leaves the tangent very slightly non-orthogonal
        // to the normal, and the error shows up as shading seams along blend
        // boundaries.
        float3 orthogonal = in.world_tangent - normal * dot(normal, in.world_tangent);
        if (length_squared(orthogonal) > 1e-8) {
            float3 tangent = normalize(orthogonal);
            float3 bitangent = cross(normal, tangent) * in.tangent_sign * side;
            float3 sampled = normal_map.sample(normal_sampler, in.uv).xyz * 2.0 - 1.0;
            normal = normalize(tangent * sampled.x + bitangent * sampled.y + normal * sampled.z);
        }
    }

    // glTF packs occlusion in R, roughness in G, metallic in B. Scales are 1 in
    // this model's materials, so the sample is used directly.
    float occlusion = 1.0;
    float roughness = 0.65;
    float metallic = 0.0;
    if (model.material.z > 0.5) {
        float3 orm = orm_map.sample(orm_sampler, in.uv).rgb;
        occlusion = orm.r;
        roughness = clamp(orm.g, 0.05, 1.0);
        metallic = orm.b;
    }

    float wrapped = saturate((dot(normal, to_sun) + 0.2) / 1.2);
    float visibility = sun_visibility(in.world_position, normal, scene, shadow_map,
                                      shadow_sampler);
    float3 direct = scene.sun_color.rgb * scene.sun.w * wrapped * visibility;

    float sky_amount = saturate(normal.y * 0.5 + 0.5);
    float3 ambient =
        mix(scene.fog_color.rgb, scene.sky_zenith.rgb, sky_amount) * scene.terrain_params.w;

    // The texture is sRGB, so the sample arrives already linear.
    float3 albedo = in.albedo;
    if (model.material.x > 0.5) {
        albedo *= base_colour.sample(base_sampler, in.uv).rgb;
    }

    // Scaly hide is not a mirror, so the specular lobe is deliberately modest:
    // a single GGX highlight, no image-based lighting, no environment probe.
    // Enough to tell wet-looking horn from matte membrane, which is all the
    // roughness map is really being asked to convey.
    float3 half_vector = normalize(to_sun + to_camera);
    float alpha = roughness * roughness;
    float n_dot_h = saturate(dot(normal, half_vector));
    float denominator = n_dot_h * n_dot_h * (alpha * alpha - 1.0) + 1.0;
    float distribution = (alpha * alpha) / max(3.14159265 * denominator * denominator, 1e-4);
    // Fresnel, with dielectrics at the usual 4% and metals tinted by albedo.
    float3 f0 = mix(float3(0.04), albedo, metallic);
    float3 fresnel = f0 + (1.0 - f0) * pow(1.0 - saturate(dot(half_vector, to_camera)), 5.0);
    float3 specular = fresnel * distribution * saturate(dot(normal, to_sun)) * 0.25;

    // Metals have no diffuse response.
    float3 diffuse = albedo * (1.0 - metallic);
    float3 lit = diffuse * (direct + ambient * occlusion) +
                 specular * scene.sun_color.rgb * scene.sun.w * visibility +
                 albedo * in.emissive;

    float distance = length(in.world_position - scene.camera_position.xyz);
    float density = scene.fog_color.a * exp(-max(in.world_position.y, 0.0) * 0.0018);
    float fog = 1.0 - exp(-pow(distance * density, 2.0));
    float3 ray = normalize(in.world_position - scene.camera_position.xyz);
    return float4(tonemap(mix(lit, sky_color(ray, scene), saturate(fog))), 1.0);
}
